APP_ENV=development
APP_SECRET_KEY=
APP_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql+psycopg://codebuddy:codebuddy@db:5432/codebuddy
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
STORAGE_PATH=/data/source
MAX_UPLOAD_MB=100
MAX_EXPANDED_MB=500
MAX_ARCHIVE_ENTRIES=50000
MAX_INDEXED_FILES=2000
MAX_FILE_BYTES=1048576
MAX_CHUNKS_PER_PROJECT=10000
EMBEDDING_BATCH_DELAY_SECONDS=10
MAX_CONTEXT_TOKENS=10000
MAX_EMBEDDING_TOKENS_PER_SNAPSHOT=1000000
MAX_QUESTION_CHARS=6000
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
LIVE_DEMO_ENABLED=false
LOG_LEVEL=INFO
